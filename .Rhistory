> plot(
m1 <- lm(y1 ~ x1, data = anscombe)
m2 <- lm(y2 ~ x2, data = anscombe)
m3 <- lm(y3 ~ x3, data = anscombe)
m4 <- lm(y4 ~ x4, data = anscombe)
summary(m1)
summary(m2)
summary(m3)
summary(m4)
m1 <- lm(y1 ~ x1, data = anscombe)
m2 <- lm(y2 ~ x2, data = anscombe)
m3 <- lm(y3 ~ x3, data = anscombe)
m4 <- lm(y4 ~ x4, data = anscombe)
# --- ۱. تنظیم صفحه برای رسم ۴ نمودار در کنار هم (۲ سطر و ۲ ستون) ---
par(mfrow = c(2, 2), mar = c(4, 4, 3, 1), family = "serif")
# --- ۲. مدل‌سازی رگرسیون برای هر ۴ مجموعه داده ---
m1 <- lm(y1 ~ x1, data = anscombe)
m2 <- lm(y2 ~ x2, data = anscombe)
m3 <- lm(y3 ~ x3, data = anscombe)
m4 <- lm(y4 ~ x4, data = anscombe)
# --- ۳. رسم نمودار ۱ (داده‌های استاندارد و خطی) ---
plot(
anscombe$x1, anscombe$y1,
col = "darkblue", pch = 19, cex = 1.3,
xlim = c(3, 20), ylim = c(3, 13),
xlab = "X1", ylab = "Y1", main = "Dataset 1: Simple Linear"
)
abline(m1, col = "firebrick", lwd = 2)
# --- ۴. رسم نمودار ۲ (رابطه غیرخطی و منحنی) ---
plot(
anscombe$x2, anscombe$y2,
col = "darkgreen", pch = 17, cex = 1.3,
xlim = c(3, 20), ylim = c(3, 13),
xlab = "X2", ylab = "Y2", main = "Dataset 2: Non-linear"
)
abline(m2, col = "firebrick", lwd = 2)
# --- ۵. رسم نمودار ۳ (وجود داده پرت / Outlier) ---
plot(
anscombe$x3, anscombe$y3,
col = "purple", pch = 15, cex = 1.3,
xlim = c(3, 20), ylim = c(3, 13),
xlab = "X3", ylab = "Y3", main = "Dataset 3: Outlier"
)
abline(m3, col = "firebrick", lwd = 2)
# --- ۶. رسم نمودار ۴ (نقطه اهرمی شدیدی / High-leverage point) ---
plot(
anscombe$x4, anscombe$y4,
col = "darkorange", pch = 18, cex = 1.5,
xlim = c(3, 20), ylim = c(3, 13),
xlab = "X4", ylab = "Y4", main = "Dataset 4: High Leverage"
)
abline(m4, col = "firebrick", lwd = 2)
# بازگرداندن تنظیمات صفحه به حالت پیش‌فرض
par(mfrow = c(1, 1))
library(readxl)
hpi_data <- "data/Happy-Planet-Index-2006-2025-public-data-set.xlsx"
# excel_sheets(hpi_data)
hpi_all <- read_excel(
hpi_data,
sheet = "All Data",
range = "A2:T3126" # rows and columns with the actual data, not labels or anything else
)
hpi_2025 <- subset(hpi_all, Year == 2025)
# nrow(hpi_2025)
# sum(is.na(hpi_2025$HPI))
hpi_2025$Region <- factor(
hpi_2025$Continent,
levels = 1:8,
labels = c(
"Latin America & Caribbean",
"U.S., Canada & Oceania",
"Western Europe",
"Middle East & North Africa",
"Sub-Saharan Africa",
"South Asia",
"Eastern Europe & Central Asia",
"East & Southeast Asia"
)
)
hpi_2025_no_na <- subset(hpi_2025, !is.na(HPI))
# nrow(hpi_2025_no_na)
# sum(is.na(hpi_2025_no_na$HPI))
library(ggplot2)
library(showtext)
install.packages ("showtext")
library(ggplot2)
library(showtext)
region_colors <- c(
"Latin America & Caribbean" = "goldenrod1",
"U.S., Canada & Oceania" = "dodgerblue3",
"Western Europe" = "royalblue4",
"Middle East & North Africa" = "plum",
"Sub-Saharan Africa" = "firebrick3",
"South Asia" = "mediumpurple1",
"Eastern Europe & Central Asia" = "seagreen4",
"East & Southeast Asia" = "yellowgreen"
)
font_add_google("Quattrocento", "quattrocento")
font_add_google("Inter", "inter")
showtext_auto()
theme_labels <- theme_minimal(base_family = "inter") +
theme(
plot.title = element_text(
family = "quattrocento",
face = "bold",
size = 18
),
plot.subtitle = element_text(
family = "quattrocento",
size = 12
),
plot.caption = element_text(
size = 9,
color = "gray40"
),
axis.title = element_text(
family = "quattrocento",
face = "bold",
size = 11
),
panel.grid.minor = element_blank(),
legend.title = element_text(
family = "quattrocento",
face = "bold"
),
legend.position = "right"
)
# 1. Aggregate Population and HPI by Region
region_summary <- hpi_2025_no_na %>%
group_by(Region) %>%
summarise(
mean_hpi = mean(HPI, na.rm = TRUE),
total_pop = sum(Population, na.rm = TRUE), # Ensure your population column is named 'Population'
.groups = "drop"
) %>%
filter(!is.na(Region)) %>%
# Calculate cumulative widths for geom_rect()
mutate(
xmax = cumsum(total_pop),
xmin = xmax - total_pop,
xcenter = (xmin + xmax) / 2
)
library(dplyr)
library(tidyverse)
mutate(
xmax = cumsum(total_pop),
xmin = xmax - total_pop,
xcenter = (xmin + xmax) / 2
)
hpi_2025_no_na |>
group_by(Region) |>
summarise(mean_hpi = mean(HPI, na.rm = TRUE)) |>
mutate(
xmax = cumsum(total_pop),
xmin = xmax - total_pop,
xcenter = (xmin + xmax) / 2
)
hpi_2025_no_na |>
group_by(Region) |>
summarise(
mean_hpi = mean(HPI, na.rm = TRUE),
total_pop = sum(Population, na.rm = TRUE) # Replace 'Population' with your actual column name
) |>
mutate(
xmax = cumsum(total_pop),
xmin = xmax - total_pop,
xcenter = (xmin + xmax) / 2
)
# 2. Build Chart 1
chart1 <- ggplot(region_summary) +
# Draw variable-width bars
geom_rect(
aes(
xmin = xmin,
xmax = xmax,
ymin = 0,
ymax = mean_hpi,
fill = Region
),
color = "white",
linewidth = 0.5
) +
scale_fill_manual(values = region_colors) +
# Format X-axis to show population in Billions/Millions
scale_x_continuous(
labels = function(x) paste0(round(x / 1e9, 1), "B")
) +
# Labels and Title
labs(
title = "Regional Happy Planet Index vs. Population Size (2025)",
subtitle = "Column width represents total population; height represents mean HPI score",
x = "Cumulative Population",
y = "Mean Happy Planet Index (HPI)",
fill = "Region",
caption = "Source: Happy Planet Index (2026 Release, Hot or Cool Institute)"
) +
theme_labels
print(chart1)
